# Database Configuration (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# PRIMARY AI PROVIDER (Assignment Requirements)
# ==============================================================================
AI_API_KEY=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_MODEL="gemini-2.0-flash"

# ==============================================================================
# OPTIONAL MULTI-PROVIDER RATE LIMIT CASCADING FAILOVER
# If one provider hits a rate limit (HTTP 429) or quota exhaustion,
# the system automatically fails over to the next configured model in the chain!
# ==============================================================================

# 1. Google Gemini (Google AI Studio - Free & Paid Tiers)
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_MODEL="gemini-2.0-flash"

# 2. Groq (Ultra-fast Inference - Generous Free Tier)
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# 3. Hugging Face Inference API / Router
HUGGINGFACE_API_KEY=""
HUGGINGFACE_BASE_URL="https://router.huggingface.co/hf-inference/v1"
HUGGINGFACE_MODEL="Qwen/Qwen2.5-72B-Instruct"

# Priority Order for Automatic Rate Limit Failover:
AI_PROVIDER_CASCADE="gemini,groq,huggingface"

# Application Limits
MAX_FILE_SIZE_MB=50
MAX_AGENT_ROUNDS=5

# Storage Configuration
STORAGE_DIR="./storage"
